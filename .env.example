# Copy to .env and edit. Never commit .env (it is git-ignored and excluded from Docker images).
# Every secret is supplied ONLY through environment variables; nothing is hard-coded.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=clearclaim
POSTGRES_USER=clearclaim
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Backend ---
# Local (non-Docker) default: SQLite file backend/claim_validator.db (run backend commands from backend\).
# DATABASE_URL=postgresql+psycopg2://clearclaim:<password>@localhost:5432/clearclaim
APP_ENV=development                  # development | test | docker | production
#   production: mutating endpoints are DISABLED (HTTP 503) unless CLEARCLAIM_WRITE_TOKEN is set.
DATA_MODE=demo                       # demo (synthetic) | mimic (local, authorised MIMIC-IV files)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Required for any shared/public deployment. Corrections, decisions, settings and experiments then
# need "Authorization: Bearer <token>" (enter it in the UI under Settings -> Access). Reads stay open.
CLEARCLAIM_WRITE_TOKEN=
ALLOW_EXPERIMENTS=true               # set false on small public hosts (CPU-heavy)
MAX_REQUEST_BYTES=262144             # bodies above this get 413; bodies without Content-Length get 411
LOG_LEVEL=INFO
AUTO_MIGRATE=true                    # run Alembic migrations at backend start-up

# --- MIMIC mode (local, authorised files only; never deploy them publicly) ---
# MIMIC_CLINICAL_DIR=../data/mimic_iv/demo
# MIMIC_ADMIN_DIR=../data/synthetic/admin_for_mimic_demo
# MIMIC_SOURCE_LABEL=MIMIC_IV_DEMO_2.2

# --- Policy explainer: optional LLM summarisation of retrieved passages (default: extractive, no API) ---
# ANTHROPIC_API_KEY=                 # requires: pip install anthropic
# OPENAI_API_KEY=                    # requires: pip install openai
# Never use an external LLM with credentialed MIMIC data.

# --- Tests (optional) ---
# TEST_DATABASE_URL=postgresql+psycopg2://clearclaim:<password>@localhost:5432/clearclaim_test   # run pytest on Postgres
# E2E_PYTHON=.venv\Scripts\python.exe                                                            # backend interpreter for e2e

# --- docker compose web port ---
WEB_PORT=8080
